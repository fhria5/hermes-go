# Wajib
LLM_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=[123456789]

# LLM (opsional)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=120s
LLM_MAX_RETRIES=3

# Agent (opsional)
AGENT_MAX_ITERATIONS=25
AGENT_MAX_TOOL_CALLS=50
TOOL_TIMEOUT=60s
TASK_TIMEOUT=10m
TASK_MAX_TOKENS=200000
SKILLS_DIR=./skills
WORKSPACE_ROOT=./workspace

# Keamanan (opsional) — allowlist shell KOSONG = shell dinonaktifkan (default aman)
SHELL_ALLOWLIST=
HTTP_ALLOWED_HOSTS=
HTTP_DENY_PRIVATE_NET=1

# Storage
HERMES_DATA_DIR=./data
HERMES_DB_PATH=./data/hermes.db
MEMORY_RETENTION_DAYS=90
